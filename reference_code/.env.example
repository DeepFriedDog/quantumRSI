# Quantum RSI DEX Trading Configuration - EXAMPLE
# Copy this file to .env and fill in your values

# Web3 provider URL (use your own Infura, Alchemy, etc. endpoint)
WEB3_PROVIDER_URI=https://mainnet.infura.io/v3/YOUR_INFURA_KEY

# Ethereum wallet private key (without 0x prefix)
# IMPORTANT: NEVER share this private key or commit it to version control
# ETH_PRIVATE_KEY=your_private_key_here

# DEX configuration
DEX_PROVIDER=uniswap  # Options: uniswap, dydx, 1inch

# Trading parameters
RISK_PER_TRADE=0.01  # 1% risk per trade
MAX_POSITIONS=2
VOLUME_THRESHOLD=2.0
VWAP_THRESHOLD=0.01

# Quantum model parameters
QUANTUM_V0=1.0  # Potential strength
QUANTUM_A=0.4   # Well position (corresponds to RSI ~30/70)
QUANTUM_M=1.0   # Effective mass
QUANTUM_HBAR=1.0  # Reduced Planck constant 